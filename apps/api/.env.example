DATABASE_URL=sqlite:///./data/gap.db
SECRET_KEY=change-me-in-production
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
WORKPLACE_DIR=./data/workplaces
DOCKER_SOCKET=unix:///var/run/docker.sock
# 国内拉 docker.io 镜像时填写镜像源前缀，如 docker.1ms.run/library
DOCKER_REGISTRY_MIRROR=
# 沙箱 bind mount 宿主机数据目录（docker-compose 部署必填，与 GAP_DATA_DIR 一致）
DOCKER_DATA_HOST_PATH=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# IM webhook 公网基址（Named Tunnel 固定域名；无尾斜杠）
# 例：PUBLIC_BASE_URL=https://api.example.com
PUBLIC_BASE_URL=
# Named tunnel（scripts/feishu-cloudflared.sh 默认）；未配置时 start-local 回退 quick
# CLOUDFLARE_TUNNEL_TOKEN=
# TUNNEL_PUBLIC_BASE_URL=https://api.example.com
# CLOUDFLARED_MODE=named
# ERR→IM：OPS_ALERT_SECRET=... OPS_ALERT_CHANNEL_ID=<im_channel_id>
# OPS_ALERT_SECRET=
# OPS_ALERT_CHANNEL_ID=

# MiniMax LLM (OpenAI-compatible)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# 语音转写（OpenAI 兼容 Whisper：POST /v1/audio/transcriptions）
# 注意：MiniMax 不提供该接口；未配置时前端会使用 Chrome/Edge 浏览器语音识别
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=whisper-1
SEED_DBA_AGENT=true

# Default sandbox image (local Docker tag)
DEFAULT_SANDBOX_IMAGE=myclaw-base:latest

# Tushare MCP (official streamable HTTP endpoint with token in URL)
TUSHARE_MCP_URL=https://api.tushare.pro/mcp/?token=your_tushare_token
SEED_TUSHARE=true
SEED_SYSTEM_LOGS=true

# System PostgreSQL for SQL tool (docker-compose default: localhost:15432)
SEED_SYSTEM_POSTGRES=true
SYSTEM_PG_HOST=127.0.0.1
SYSTEM_PG_PORT=15432
SYSTEM_PG_USER=gap
SYSTEM_PG_PASSWORD=gap
SYSTEM_PG_DATABASE=gap
