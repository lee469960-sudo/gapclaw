# 复制为 .env 后修改：cp .env.example .env
# 兼容 docker-compose v1 / docker compose v2

# 架构：amd 或 arm（render-env.sh 默认按本机 uname 自动选择；仅手动覆盖时设 GAP_ARCH_FORCE=1）
GAP_ARCH=amd
# GAP_ARCH_FORCE=1

# 镜像版本
GAP_VERSION=V0.0.1

# 阿里云镜像仓库（远程部署填写；本地留空）
GAP_REGISTRY=crpi-scibloubqf62j8nh.cn-chengdu.personal.cr.aliyuncs.com
GAP_NAMESPACE=tools_claw
GAP_DB_NAMESPACE=tools_dba
GAP_DB_TAG=16-alpine

# 以下由脚本自动拼出，也可直接覆盖整行镜像名
# GAP_IMAGE_API=
# GAP_IMAGE_WEB=
# GAP_IMAGE_DB=

# Web 访问地址（CORS 放行，填浏览器打开的地址，如 http://服务器IP:5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 宿主机数据目录（沙箱卷挂载用，render-env.sh 自动写入绝对路径）
# API 会优先从容器挂载信息自动解析宿主机路径；也可手动指定：
# GAP_DATA_DIR=
# DOCKER_DATA_HOST_PATH=

# 可选：宿主机 Docker 镜像加速（在 /etc/docker/daemon.json 配置 registry-mirrors 更彻底）
# API 拉取简单镜像名（如 python:3.12-slim）时使用此前缀：
# DOCKER_REGISTRY_MIRROR=docker.1ms.run/library

# 可选：宿主机暴露 Postgres（默认不暴露，避免端口冲突）
# 在 docker-compose.yml 的 db.ports 取消注释并修改端口
# GAP_DB_HOST_PORT=15433

# 语音转写（OpenAI 兼容 Whisper）。未配置时对话页录音会提示错误
# ASR_API_KEY=
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_MODEL=whisper-1
# MINIMAX_API_KEY=  # ASR_API_KEY 为空时回退使用

# IM Webhook 公网基址（本地 cloudflared：https://xxxx.trycloudflare.com，无尾斜杠）
# PUBLIC_BASE_URL=

# RAG 语义检索（OpenAI 兼容 /v1/embeddings）。未配置时使用词法 Jaccard 回退
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# RAG_MAX_UPLOAD_MB=32
# RAG_CANDIDATE_LIMIT=2000
#
# 真向量加速：DB 镜像需带 pgvector（如 pgvector/pgvector:pg16），启动时会 CREATE EXTENSION vector
# GAP_IMAGE_DB=pgvector/pgvector:pg16
