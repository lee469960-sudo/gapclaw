# 复制为 .env 后修改：cp .env.example .env
# 兼容 docker-compose v1 / docker compose v2

# 架构：amd 或 arm（render-env.sh 默认按本机 uname 自动选择；仅手动覆盖时设 GAP_ARCH_FORCE=1）
GAP_ARCH=amd
# GAP_ARCH_FORCE=1

# 镜像版本
GAP_VERSION=V0.0.3

# 阿里云镜像仓库（远程部署填写；本地留空）
GAP_REGISTRY=crpi-scibloubqf62j8nh.cn-chengdu.personal.cr.aliyuncs.com
GAP_NAMESPACE=tools_claw
GAP_DB_NAMESPACE=tools_dba
GAP_DB_TAG=16-alpine

# 以下由脚本自动拼出，也可直接覆盖整行镜像名
# GAP_IMAGE_API=
# GAP_IMAGE_WEB=
# GAP_IMAGE_DB=

# Web 访问地址（CORS 放行，填浏览器打开的地址，如 http://服务器IP:5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 宿主机数据目录（沙箱卷挂载用，render-env.sh 自动写入绝对路径）
# API 会优先从容器挂载信息自动解析宿主机路径；也可手动指定：
# GAP_DATA_DIR=
# DOCKER_DATA_HOST_PATH=

# CodeAgent Workspace 双根：API 容器视角（/app/data/code-agent/runs）与
# Docker daemon 宿主机视角（${GAP_DATA_DIR}/code-agent/runs）必须指向同一存储，
# 即同一个 /app/data bind mount 的两端。docker-compose.yml 已按此声明，
# 一般无需覆盖；仅自定义挂载拓扑时才需要同步修改。
# CODE_WORKSPACE_API_ROOT=/app/data/code-agent/runs
# CODE_WORKSPACE_HOST_ROOT=/app/data/code-agent/runs

# CodeAgent 仓库来源与镜像安全配置。HTTP 仓库默认要求内网 CIDR；若仓库只能通过
# 可信代理访问，可显式开启 transport proxy 模式并填写仓库专用代理。
# CODE_REPOSITORY_ALLOWLIST=["http://g.testskydata.com:2222"]
# CODE_REPOSITORY_INTERNAL_CIDRS=["10.20.0.0/16"]
# CODE_REPOSITORY_USE_TRANSPORT_PROXY=false
# CODE_REPOSITORY_ALLOW_PUBLIC_HTTP=false
# CODE_REPOSITORY_HTTP_PROXY=http://host.docker.internal:7897
# CODE_REPOSITORY_HTTPS_PROXY=http://host.docker.internal:7897
# 生产用 deploy/build-code-agent-runner.sh --push <registry-image>:<tag> 发布 arm64/amd64，
# 然后填 registry manifest-list digest；不要填本机单架构 digest。
# CODE_TRUSTED_IMAGE_DIGESTS=["registry.example.com/ns/code-agent-runner@sha256:<manifest-list-digest>"]
# CODE_CLAUDE_CODE_RUNTIME_ENABLED=false

# 可选：宿主机 Docker 镜像加速（在 /etc/docker/daemon.json 配置 registry-mirrors 更彻底）
# API 拉取简单镜像名（如 python:3.12-slim）时使用此前缀：
# DOCKER_REGISTRY_MIRROR=docker.1ms.run/library

# 可选：宿主机暴露 Postgres（默认不暴露，避免端口冲突）
# 在 docker-compose.yml 的 db.ports 取消注释并修改端口
# GAP_DB_HOST_PORT=15433

# 语音转写（OpenAI 兼容 Whisper）。未配置时对话页录音会提示错误
# ASR_API_KEY=
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_MODEL=whisper-1
# MINIMAX_API_KEY=  # ASR_API_KEY 为空时回退使用

# IM Webhook 公网基址（本地 cloudflared：https://xxxx.trycloudflare.com，无尾斜杠）
# PUBLIC_BASE_URL=

# RAG 语义检索（OpenAI 兼容 /v1/embeddings）。未配置时使用词法 Jaccard 回退
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# RAG_MAX_UPLOAD_MB=32
# RAG_CANDIDATE_LIMIT=2000
#
# 真向量加速：DB 镜像需带 pgvector（如 pgvector/pgvector:pg16），启动时会 CREATE EXTENSION vector
# GAP_IMAGE_DB=pgvector/pgvector:pg16

# --- Production release (scripts/deploy.sh + docker-compose.prod.yml) ---
# GitHub Actions 构建的 API 仓库路径 = ${ALIYUN_REGISTRY}/${ALIYUN_IMAGE}
# 例: crpi-xxxx.cn-chengdu.personal.cr.aliyuncs.com/tools_claw/gap-api
# Web 默认把末尾 -api 换成 -web: .../tools_claw/gap-web
IMAGE_API=
IMAGE_WEB=
IMAGE_TAG=v1.0.0
# 数据库镜像不随应用 Tag 构建，填本机已有 ACR/Docker Hub 地址
IMAGE_DB=
API_PORT=8000
WEB_PORT=5173
# 生产务必覆盖以下占位值（真实值只放本机 .env，禁止提交）
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
POSTGRES_USER=gap
POSTGRES_PASSWORD=gap
POSTGRES_DB=gap
# ACR 登录（部署机 / GitHub Secrets）。密码不要提交仓库。
ALIYUN_REGISTRY=
ALIYUN_REGISTRY_USERNAME=
ALIYUN_REGISTRY_PASSWORD=
ALIYUN_IMAGE=
