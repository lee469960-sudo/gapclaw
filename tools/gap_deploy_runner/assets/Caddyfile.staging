staging.gapclaw.online {
  @api path /api/* /pages/* /hooks/* /ws* /health /docs* /openapi.json
  handle @api {
    reverse_proxy 127.0.0.1:18000
  }
  handle {
    reverse_proxy 127.0.0.1:18080
  }
}

runner-staging.gapclaw.online {
  tls {
    client_auth {
      mode require_and_verify
      trust_pool file /etc/caddy/staging/runner-ca.crt
    }
  }

  @release_callback path /internal/release-runner/callback
  handle @release_callback {
    reverse_proxy 127.0.0.1:18000 {
      header_up Host staging.gapclaw.online
      header_up X-Gap-Runner-Client-Verify SUCCESS
    }
  }
  handle {
    respond "not found" 404
  }
}
