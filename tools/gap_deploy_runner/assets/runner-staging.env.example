# Staging-only fixed private Runner listener and certificate locations.
GAP_RUNNER_TARGET_ID=staging
GAP_RUNNER_LISTEN=172.17.0.1:19443
GAP_RUNNER_TLS_CA_FILE=/opt/gap-staging-runner/tls/ca.crt
GAP_RUNNER_TLS_CERT_FILE=/opt/gap-staging-runner/tls/runner.crt
GAP_RUNNER_TLS_KEY_FILE=/opt/gap-staging-runner/tls/runner.key
