[Unit]
Description=GAP Deploy Runner restricted mTLS control service
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=gap-runner
Group=gap-runner
SupplementaryGroups=docker
EnvironmentFile=/opt/gap-runner/runner.env
ExecStart=/opt/gap-runner/bin/gap-deploy-runner-server --root /opt/gap-runner --app-env /opt/gap/.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/gap-runner/state
UMask=0077

[Install]
WantedBy=multi-user.target
