# Fixed private Runner listener and certificate locations. Keep this file mode 0640.
# Bind the Linux Docker bridge only; host firewall must allow 9443 only from this bridge.
GAP_RUNNER_TARGET_ID=production
GAP_RUNNER_LISTEN=172.17.0.1:9443
GAP_RUNNER_TLS_CA_FILE=/opt/gap-runner/tls/ca.crt
GAP_RUNNER_TLS_CERT_FILE=/opt/gap-runner/tls/runner.crt
GAP_RUNNER_TLS_KEY_FILE=/opt/gap-runner/tls/runner.key
