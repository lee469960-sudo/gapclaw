# Staging ACR pull-only identity. Grant AcrPull only; never grant push/delete roles.
ALIYUN_REGISTRY=registry.example.com
ALIYUN_REGISTRY_USERNAME=gap-staging-pull
ALIYUN_REGISTRY_PASSWORD=replace-with-staging-pull-only-secret
ALIYUN_IMAGE=namespace/gap-api
IMAGE_DB=registry.example.com/namespace/gap-db@sha256:replace-with-immutable-digest
GAP_DATA_DIR=/opt/gap-staging/data
API_PORT=18000

RELEASE_ENVIRONMENT=staging
RELEASE_RUNNER_CA_FILE=/run/gap-release-mtls/ca.crt
RELEASE_RUNNER_CLIENT_CERT_FILE=/run/gap-release-mtls/gap-client.crt
RELEASE_RUNNER_CLIENT_KEY_FILE=/run/gap-release-mtls/gap-client.key
RELEASE_RUNNER_TIMEOUT_SECONDS=10
